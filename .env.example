# Copy to .env.local and fill in real values.
# Do not commit .env.local.

AIMLAPI_API_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_MODEL_PRIMARY=gpt-4o-mini
AIMLAPI_MODEL_FAST=gpt-4o-mini
AIMLAPI_TIMEOUT_SECONDS=45

# Keep demo stable if the provider is unavailable.
# Set to 0 to force deterministic local outputs only.
ENABLE_LIVE_LLM=1

# Optional: for real Band live mode, create one Remote Agent per role in Band
# and add their agent IDs/API keys to agent_config.yaml.
BAND_ENABLED=0
BAND_APP_URL=https://app.band.ai
BAND_USER_API_KEY=
